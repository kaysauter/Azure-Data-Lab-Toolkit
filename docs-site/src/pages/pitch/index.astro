---
const deck = '/Azure-Data-Lab-Toolkit/pitch/deck/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="refresh" content={`0; url=${deck}`} />
		<link rel="canonical" href={deck} />
		<title>Azure Data Lab Toolkit Pitch Deck</title>
		<script is:inline>
			window.location.replace('/Azure-Data-Lab-Toolkit/pitch/deck/');
		</script>
	</head>
	<body>
		<p>Open the <a href={deck}>Azure Data Lab Toolkit pitch deck</a>.</p>
	</body>
</html>
