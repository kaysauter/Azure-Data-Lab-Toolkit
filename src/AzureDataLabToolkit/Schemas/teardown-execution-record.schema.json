{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaysauter.github.io/Azure-Data-Lab-Toolkit/schemas/teardown-execution-record-1.0.json",
  "title": "Azure Data Lab Toolkit teardown execution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "canonicalization",
    "operation",
    "operationId",
    "runId",
    "planHash",
    "intentHash",
    "scope",
    "deploymentExecutionRecordHash",
    "inventory",
    "cleanupLease",
    "deleteAction",
    "createdAt",
    "teardownExecutionRecordHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "AzureDataLabTeardownExecutionRecord"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "operation": {
      "const": "teardown"
    },
    "operationId": {
      "$ref": "#/$defs/uuid"
    },
    "runId": {
      "$ref": "#/$defs/uuid"
    },
    "planHash": {
      "$ref": "#/$defs/hash"
    },
    "intentHash": {
      "$ref": "#/$defs/hash"
    },
    "scope": {
      "$ref": "#/$defs/azureScope"
    },
    "deploymentExecutionRecordHash": {
      "$ref": "#/$defs/hash"
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "resourceGroupId",
        "resourceGroupStatus",
        "resourceGroupProofHash",
        "resourceCount",
        "resources",
        "inventoryHash"
      ],
      "properties": {
        "capturedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "resourceGroupId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[A-Za-z0-9._()\\-]{1,90}$"
        },
        "resourceGroupStatus": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "resourceGroupProofHash": {
          "$ref": "#/$defs/hash"
        },
        "resourceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "resources": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stableId",
              "resourceId",
              "resourceType",
              "apiVersion",
              "etag",
              "observationFingerprint",
              "relationship",
              "required",
              "proofHash"
            ],
            "properties": {
              "stableId": {
                "type": "string",
                "pattern": "^(azure|engine)\\.[a-z0-9][a-z0-9.-]+$"
              },
              "resourceId": {
                "type": "string",
                "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[A-Za-z0-9._()\\-]{1,90}/providers/[A-Za-z0-9.]+/[A-Za-z0-9._()\\-/]{1,512}$"
              },
              "resourceType": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.]+/[A-Za-z0-9./]+$"
              },
              "apiVersion": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}(-preview)?$"
              },
              "etag": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observationFingerprint": {
                "$ref": "#/$defs/hash"
              },
              "relationship": {
                "enum": [
                  "planned-taggable",
                  "planned-descendant",
                  "vm-managed-disk",
                  "nested-deployment",
                  "sql-iaas-agent-extension"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "proofHash": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        },
        "inventoryHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "cleanupLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryHash",
        "confirmationPhraseHash",
        "approver",
        "mechanism",
        "recordId",
        "approvedAt",
        "expiresAt"
      ],
      "properties": {
        "inventoryHash": {
          "$ref": "#/$defs/hash"
        },
        "confirmationPhraseHash": {
          "$ref": "#/$defs/hash"
        },
        "approver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "user"
            },
            "id": {
              "$ref": "#/$defs/uuid"
            }
          }
        },
        "mechanism": {
          "const": "interactive"
        },
        "recordId": {
          "type": "string",
          "pattern": "^interactive:[0-9a-fA-F-]{36}$"
        },
        "approvedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "deleteAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceGroupName",
        "resourceId",
        "strategy",
        "retainResourceGroup",
        "operationRequired"
      ],
      "properties": {
        "resourceGroupName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._()\\-]{1,90}$"
        },
        "resourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[A-Za-z0-9._()\\-]{1,90}$"
        },
        "strategy": {
          "const": "exact-resource-ids"
        },
        "retainResourceGroup": {
          "const": true
        },
        "operationRequired": {
          "type": "boolean"
        }
      }
    },
    "createdAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "teardownExecutionRecordHash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "azureScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloud",
        "tenantId",
        "subscriptionId",
        "resourceGroupName",
        "location"
      ],
      "properties": {
        "cloud": {
          "const": "AzureCloud"
        },
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "subscriptionId": {
          "$ref": "#/$defs/uuid"
        },
        "resourceGroupName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._()\\-]{1,90}$"
        },
        "location": {
          "type": "string",
          "pattern": "^[a-z0-9]+$",
          "minLength": 2,
          "maxLength": 40
        }
      }
    }
  }
}
