{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaysauter.github.io/Azure-Data-Lab-Toolkit/schemas/catalog-1.0.json",
  "title": "Azure Data Lab Toolkit catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "catalogType",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "AzureDataLabCatalog"
    },
    "catalogType": {
      "enum": [
        "software",
        "sample-data"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "version",
          "publisher",
          "home",
          "attribution",
          "platforms",
          "tags",
          "source",
          "license",
          "integrity",
          "privileges",
          "sensitivity",
          "compatibility",
          "probes",
          "supportStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(software|sample-data)\\.[a-z0-9][a-z0-9.-]+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "not": {
              "enum": [
                "latest",
                "unresolved"
              ]
            }
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "home": {
            "$ref": "#/$defs/httpsUri"
          },
          "attribution": {
            "$ref": "#/$defs/httpsUri"
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "uri"
            ],
            "properties": {
              "type": {
                "enum": [
                  "powershell-gallery",
                  "github-release",
                  "https"
                ]
              },
              "uri": {
                "$ref": "#/$defs/httpsUri"
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spdx",
              "uri"
            ],
            "properties": {
              "spdx": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "$ref": "#/$defs/httpsUri"
              }
            }
          },
          "integrity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "algorithm"
            ],
            "properties": {
              "status": {
                "enum": [
                  "required-before-deployment",
                  "verified"
                ]
              },
              "algorithm": {
                "const": "sha256"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "verified"
                    }
                  }
                },
                "then": {
                  "required": [
                    "digest"
                  ]
                }
              }
            ]
          },
          "privileges": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requiresElevation"
            ],
            "properties": {
              "requiresElevation": {
                "type": "boolean"
              }
            }
          },
          "sensitivity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "classification"
            ],
            "properties": {
              "classification": {
                "enum": [
                  "not-applicable",
                  "public-sample",
                  "user-declared"
                ]
              }
            }
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetTypes"
            ],
            "properties": {
              "targetTypes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "probes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "supportStatus": {
            "const": "metadata-only"
          }
        }
      }
    }
  },
  "$defs": {
    "httpsUri": {
      "type": "string",
      "pattern": "^https://"
    }
  }
}
