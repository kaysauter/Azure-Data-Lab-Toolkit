{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaysauter.github.io/Azure-Data-Lab-Toolkit/schemas/evidence-cleanup-proof-payload-1.0.json",
  "title": "Azure Data Lab Toolkit cleanup proof evidence payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "teardownExecutionRecordHash",
    "operationId",
    "resourceGroupId",
    "approvedResourceSetHash",
    "approvedResourceCount",
    "remainingApprovedResourceCount",
    "resourceGroupState",
    "retainedUnapprovedResourceCount",
    "observedState",
    "observationSource",
    "checkedAt"
  ],
  "properties": {
    "teardownExecutionRecordHash": {
      "$ref": "#/$defs/hash"
    },
    "operationId": {
      "$ref": "#/$defs/uuid"
    },
    "resourceGroupId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[A-Za-z0-9._()\\-]{1,90}$"
    },
    "approvedResourceSetHash": {
      "$ref": "#/$defs/hash"
    },
    "approvedResourceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "remainingApprovedResourceCount": {
      "const": 0
    },
    "resourceGroupState": {
      "enum": [
        "present",
        "absent"
      ]
    },
    "retainedUnapprovedResourceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "observedState": {
      "const": "approved-resources-absent"
    },
    "observationSource": {
      "const": "Get-AzResource"
    },
    "checkedAt": {
      "$ref": "#/$defs/utcTimestamp"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    }
  }
}
