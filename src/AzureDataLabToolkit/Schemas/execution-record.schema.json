{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaysauter.github.io/Azure-Data-Lab-Toolkit/schemas/execution-record-1.0.json",
  "title": "Azure Data Lab Toolkit execution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "canonicalization",
    "operation",
    "operationId",
    "runId",
    "planHash",
    "intentHash",
    "scope",
    "preflight",
    "authorization",
    "authorizationHash",
    "teardownPlan",
    "finalGate",
    "deployment",
    "createdAt",
    "executionRecordHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "AzureDataLabExecutionRecord"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "operation": {
      "const": "deploy"
    },
    "operationId": {
      "$ref": "#/$defs/uuid"
    },
    "runId": {
      "$ref": "#/$defs/uuid"
    },
    "planHash": {
      "$ref": "#/$defs/hash"
    },
    "intentHash": {
      "$ref": "#/$defs/hash"
    },
    "scope": {
      "$ref": "#/$defs/azureScope"
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveResolutionEvidenceHash",
        "whatIfEvidenceHash",
        "costEvidenceHash",
        "teardownPreviewEvidenceHash"
      ],
      "properties": {
        "liveResolutionEvidenceHash": {
          "$ref": "#/$defs/hash"
        },
        "whatIfEvidenceHash": {
          "$ref": "#/$defs/hash"
        },
        "costEvidenceHash": {
          "$ref": "#/$defs/hash"
        },
        "teardownPreviewEvidenceHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "authorization": {
      "type": "object"
    },
    "authorizationHash": {
      "$ref": "#/$defs/hash"
    },
    "teardownPlan": {
      "type": "object"
    },
    "finalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveFactsHash",
        "whatIfHash",
        "finalGateHash",
        "completedAt"
      ],
      "properties": {
        "liveFactsHash": {
          "$ref": "#/$defs/hash"
        },
        "whatIfHash": {
          "$ref": "#/$defs/hash"
        },
        "finalGateHash": {
          "$ref": "#/$defs/hash"
        },
        "completedAt": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "name",
        "location",
        "templateHash",
        "parameterReferenceHash",
        "parameterFileHash",
        "executionArtifactDigest",
        "expectedGeneratedResourceSetHash"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}$"
        },
        "name": {
          "type": "string",
          "pattern": "^adlt-deploy-[a-f0-9]{8}-[a-f0-9]{12}$"
        },
        "location": {
          "type": "string",
          "pattern": "^[a-z0-9]+$",
          "minLength": 2,
          "maxLength": 40
        },
        "templateHash": {
          "$ref": "#/$defs/hash"
        },
        "parameterReferenceHash": {
          "$ref": "#/$defs/hash"
        },
        "parameterFileHash": {
          "$ref": "#/$defs/hash"
        },
        "executionArtifactDigest": {
          "$ref": "#/$defs/hash"
        },
        "expectedGeneratedResourceSetHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "createdAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "executionRecordHash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "azureScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloud",
        "tenantId",
        "subscriptionId",
        "resourceGroupName",
        "location"
      ],
      "properties": {
        "cloud": {
          "const": "AzureCloud"
        },
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "subscriptionId": {
          "$ref": "#/$defs/uuid"
        },
        "resourceGroupName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90,
          "pattern": "^[^<>%&:\\\\?/#]+[^.\\s]$"
        },
        "location": {
          "type": "string",
          "pattern": "^[a-z0-9]+$",
          "minLength": 2,
          "maxLength": 40
        }
      }
    }
  }
}
