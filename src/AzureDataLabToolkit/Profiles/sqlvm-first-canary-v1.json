{
  "schemaVersion": "1.0",
  "kind": "AzureDataLabDeploymentProfile",
  "id": "sqlvm-first-canary/v1",
  "version": 1,
  "targetType": "sqlVm",
  "engine": "powershell",
  "status": "protected-alpha",
  "template": "sqlvm-first-canary",
  "exactConfiguration": {
    "target.type": "sqlVm",
    "metadata.purpose": "canary",
    "azure.authentication.mode": "interactive-user",
    "azure.authentication.contextScope": "process",
    "azure.resourceGroup.mode": "create",
    "engine.type": "powershell",
    "security.vmManagedIdentity": "system-assigned",
    "security.secretStore.mode": "reuse-key-vault",
    "security.administrativeAccess.mode": "deploy-bastion",
    "security.administrativeAccess.sku": "basic",
    "security.vmAdministratorCredential.source": "key-vault-secret",
    "security.vmAdministratorCredential.allowShellOutput": false,
    "security.containsSensitiveData": false,
    "cost.estimateRequested": true,
    "lifecycle.expiryBehavior": "cleanup-only",
    "lifecycle.teardown.mode": "preauthorized-canary",
    "lifecycle.teardown.strategy": "exact-resource-ids",
    "lifecycle.teardown.retainResourceGroup": true,
    "lifecycle.teardown.freshInventoryRequired": true,
    "lifecycle.teardown.retainBackupShare": false,
    "capabilities.backupShare.enabled": false,
    "solutionPacks.sqlVmBackupRestore.enabled": false,
    "sqlVm.platform": "windows",
    "sqlVm.sqlServerVersion": "2022",
    "sqlVm.compute.vmSize": "Standard_D4s_v5",
    "sqlVm.compute.securityType": "trustedLaunch",
    "sqlVm.compute.encryptionAtHost": true,
    "sqlVm.network.vmPublicIp": false
  },
  "requiredConfigurationPaths": [
    "azure.tenantId",
    "azure.subscriptionId",
    "azure.location",
    "azure.resourceGroup.name",
    "security.secretStore.resourceId",
    "security.secretStore.diagnosticDestinationResourceId",
    "security.vmAdministratorCredential.secretName",
    "security.vmAdministratorCredential.secretVersion",
    "cost.maximumRunCost.amountMinorUnits",
    "cost.maximumRunCost.currency",
    "lifecycle.maximumRuntimeMinutes",
    "lifecycle.timeToLiveMinutes"
  ],
  "emptyConfigurationPaths": [
    "sqlVm.compute.diskEncryptionSetId",
    "sqlVm.software.catalogIds",
    "sqlVm.sampleData.catalogIds"
  ],
  "requiredLiveChecks": [
    "azure-context",
    "provider-registration",
    "key-vault-security",
    "key-vault-audit-diagnostics",
    "secret-version-validity",
    "principal-authorization",
    "marketplace-image",
    "vm-sku-capability",
    "resource-ownership",
    "cost-ceiling",
    "native-arm-what-if",
    "teardown-preview"
  ]
}
